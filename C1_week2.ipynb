    "    \"hellinger\":      hellinger_distance,\n",
    "    \"cosine\":         cosine_distance,\n",
    "    \"correlation\":    correlation_distance,\n",
    "    \"jensen_shannon\": jensen_shannon_distance,\n",
    "}\n",
